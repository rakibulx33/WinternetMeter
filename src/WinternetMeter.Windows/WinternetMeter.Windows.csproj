<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Minimum OS (Windows 10 1809+) is enforced by .NET 10 itself and the installer's MinVersion.
         A versioned TFM (net10.0-windows10.0.x) would add ~25 MB of unused WinRT projections. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Sharp text on mixed-DPI setups (laptop at 150% + monitor at 100%). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>WinternetMeter</AssemblyName>
    <RootNamespace>WinternetMeter.Windows</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Lets the project be built (not run) from Linux/macOS, e.g. in CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the single-file exe needs nothing next to it. -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinternetMeter.Core\WinternetMeter.Core.csproj" />
  </ItemGroup>

</Project>
