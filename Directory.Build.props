<Project>
  <!-- Shared by every project. The release workflow overrides Version from the git tag. -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <Authors>Rakibul Hasan</Authors>
    <Product>Winternet Meter</Product>
    <Copyright>© Rakibul Hasan</Copyright>
    <RepositoryUrl>https://github.com/rakibulx33/WinternetMeter</RepositoryUrl>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep the version clean (no "+commit" suffix) for the menu header. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
